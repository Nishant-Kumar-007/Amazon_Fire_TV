{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "viewease-tv",
  "cleanUrls": true,
  "outputDirectory": "apps/expo-multi-tv/dist",
  "rewrites": [
    {
      "source": "/((?!assets|recordings|_expo|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/recordings/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        }
      ]
    }
  ]
}
